rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      // Clients cannot change credits (server/admin only).
      allow update: if isOwner(userId)
        && request.resource.data.credits == resource.data.credits;
    }

    match /characters/{characterId} {
      allow read: if resource.data.isSample == true
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Creates go through Admin SDK for consistency; allow owner create if needed later.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /scenes/{sceneId} {
      allow read: if resource.data.isSample == true
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // Admin SDK / server actions only
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
