{
  "entities": {
    "User": {
      "description": "Outpost user profile (seeker or employer).",
      "fields": {
        "email": "string",
        "displayName": "string | null",
        "photoURL": "string | null",
        "createdAt": "timestamp",
        "role": "seeker | employer",
        "companyName": "string | null (optional)",
        "credits": "number — posting credits for employers"
      }
    },
    "Job": {
      "description": "Remote job listing (aggregated or employer-posted).",
      "fields": {
        "title": "string",
        "companyName": "string",
        "companyLogo": "string | null",
        "category": "string",
        "tags": "string[]",
        "jobType": "full_time | part_time | contract | freelance | internship | other",
        "location": "string (remote region)",
        "salary": "string | null",
        "description": "string (HTML or plain text)",
        "applyUrl": "string",
        "source": "remotive | employer",
        "externalId": "string | null",
        "postedBy": "string | null (employer uid)",
        "status": "active | closed",
        "publishedAt": "timestamp | ISO string"
      }
    },
    "Product": {
      "description": "Purchasable posting credit pack.",
      "fields": {
        "name": "string",
        "stripe_price_id": "string",
        "credit_amount": "number",
        "price_usd": "number",
        "display_tag": "string | null"
      }
    }
  }
}
