{
  "entities": {
    "User": {
      "description": "Reelwright user profile.",
      "fields": {
        "email": "string",
        "displayName": "string | null",
        "photoURL": "string | null",
        "createdAt": "timestamp",
        "credits": "number — generation credits (server-managed)",
        "total_generations": "number — server-managed counter"
      }
    },
    "Character": {
      "description": "User-owned character reference for Omni continuity.",
      "fields": {
        "userId": "string",
        "name": "string",
        "description": "string",
        "style": "string",
        "imageUrl": "string | null — optional uploaded reference still (Firebase Storage download URL)",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "Scene": {
      "description": "Generated or edited reel (written by Admin SDK).",
      "fields": {
        "userId": "string",
        "title": "string",
        "prompt": "string",
        "characterIds": "string[]",
        "interactionId": "string | null",
        "videoUrl": "string | null",
        "status": "draft | generating | ready | error",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    },
    "Product": {
      "description": "Purchasable credit pack.",
      "fields": {
        "name": "string",
        "stripe_price_id": "string",
        "credit_amount": "number",
        "price_usd": "number",
        "display_tag": "string | null"
      }
    }
  }
}
